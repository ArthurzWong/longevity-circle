# ─────────────────────────────────────────────────────────────
# Longevity Circle — environment template
# Copy to .env.local and fill in only what you use.
# The MVP runs fully in DEMO MODE with none of these set.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Data provider ────────────────────────────────────────────
# "demo"  → localStorage-backed demo provider (default, no backend needed)
# "supabase" → Supabase PostgreSQL + Auth + Storage
NEXT_PUBLIC_DATA_PROVIDER=demo

# ── Supabase (required when NEXT_PUBLIC_DATA_PROVIDER=supabase) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / LLM abstraction layer ───────────────────────────────
# Client mode: "demo" (rule-based, grounded in seed knowledge, no key needed)
# or "server" (proxy through /api/ai/chat so keys never reach the browser).
NEXT_PUBLIC_AI_MODE=demo

# Server-side provider selection for /api/ai/chat.
# Provider can be swapped later without touching app code.
# Allowed: demo | openai | anthropic
LLM_PROVIDER=demo
LLM_MODEL=                       # e.g. gpt-4o-mini / claude-sonnet-4-20250514
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: retrieval service used by the server AI route (pgvector via Supabase)
RAG_MATCH_FUNCTION=match_knowledge_chunks
RAG_DEFAULT_MATCH_COUNT=8

# ── Content pipeline (Creator Studio, Phase 2) ───────────────
TRANSCRIPTION_PROVIDER=demo      # demo | deepgram | whisper
DEEPGRAM_API_KEY=
